# AstraPay SNAP sandbox secrets for the `astrapay` Edge Function.
#
# These are SERVER-SIDE only — never put them in EXPO_PUBLIC_* / NEXT_PUBLIC_*.
# Set them on the hosted project so phones/projector can reach the function:
#
#   supabase secrets set --env-file supabase/functions/astrapay/.env
#
# (copy this file to `.env`, fill the real values, then run the command above.
#  `.env` is gitignored. The RSA key lives in .docs/AstraPay-Sandbox/.)

ASTRAPAY_BASE_URL=https://sandbox.astrapay.com/snap-service/snap/v1.0
ASTRAPAY_CLIENT_ID=your-client-id
ASTRAPAY_CLIENT_SECRET=your-client-secret
ASTRAPAY_MERCHANT_ID=your-merchant-id

# PKCS#8 private key, single line with literal \n between lines, e.g.:
# ASTRAPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
ASTRAPAY_PRIVATE_KEY=

# Account binding stores the bound wallet token via the service role; SUPABASE_URL
# and SUPABASE_SERVICE_ROLE_KEY are injected into deployed functions automatically
# (no need to set them here).
#
# Payment-notification webhook (async settlement) lives in functions/astrapay-webhook.
# Ask AstraPay to register this as the merchant notification callback:
#   https://<project-ref>.supabase.co/functions/v1/astrapay-webhook
