{
  "name": "umotor",
  "private": true,
  "scripts": {
    "console:dev": "pnpm --filter @umotor/console dev",
    "console:build": "pnpm --filter @umotor/console build",
    "consumer:start": "pnpm --filter @umotor/consumer start",
    "partner:start": "pnpm --filter @umotor/partner start",
    "consumer:build:android": "pnpm --filter @umotor/consumer eas:build:android",
    "consumer:build:ios": "pnpm --filter @umotor/consumer eas:build:ios",
    "consumer:build": "pnpm --filter @umotor/consumer eas:build",
    "consumer:local:android": "pnpm --filter @umotor/consumer local:android",
    "partner:build:android": "pnpm --filter @umotor/partner eas:build:android",
    "partner:build:ios": "pnpm --filter @umotor/partner eas:build:ios",
    "partner:build": "pnpm --filter @umotor/partner eas:build",
    "partner:local:android": "pnpm --filter @umotor/partner local:android",
    "db:reset": "npx supabase db reset --linked",
    "test": "node --test \"packages/shared/src/**/*.test.ts\"",
    "test:smoke": "node scripts/astrapay-smoke.mjs"
  },
  "devDependencies": {
    "supabase": "^2.106.0"
  }
}
