# Hosted Supabase project (Settings → API). Phones must reach this over the internet.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: unofficial Samsat plate-lookup API base (vehicle brand/model/year).
# Defaults to a public Yogyakarta scraper; override with your own/aggregator.
# Cleartext http is blocked on web (mixed content) and iOS (ATS) — the app
# falls back to a local region-aware estimator when the API can't be reached.
# EXPO_PUBLIC_SAMSAT_API=http://your-samsat-proxy.example.com
