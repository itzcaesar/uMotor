# Hosted Supabase project (Settings → API). Phones must reach this over the internet.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# AstraPay SNAP payments. Off by default → uses the mock (safe for demo).
# Set to 1 to hit the real sandbox via the `astrapay` Edge Function (which must
# have its secrets configured — see supabase/functions/astrapay/.env.example).
# EXPO_PUBLIC_ASTRAPAY_LIVE=1
# Optional test wallet phone for sandbox binding (OTP is 111111):
# EXPO_PUBLIC_ASTRAPAY_PHONE=08123456789

# Optional: unofficial Samsat plate-lookup API base (vehicle brand/model/year).
# Defaults to a public Yogyakarta scraper; override with your own/aggregator.
# Cleartext http is blocked on web (mixed content) and iOS (ATS) — the app
# falls back to a local region-aware estimator when the API can't be reached.
# EXPO_PUBLIC_SAMSAT_API=http://your-samsat-proxy.example.com
